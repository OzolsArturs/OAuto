
# BEGIN WPForms
# Direktīvas (līnijas) starp `BEGIN WPForms` and `END WPForms` ir
# dinamiski ģenerētas un tās vajadzētu modificēt vienīgi izmantojot WordPress filtrus.
# Jebkuras izmaiņas šajās direktīvās starp iezīmēm tiks pārrakstītas.
# Disable access for any file in the cache dir.
# Apache 2.2
<IfModule !authz_core_module>
	Deny from all
</IfModule>

# Apache 2.4+
<IfModule authz_core_module>
	Require all denied
</IfModule>
# END WPForms